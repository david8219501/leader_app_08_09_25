# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/
/package-lock.json # קבצי נעילה של NPM - אפשר להוסיף אם משתמשים ב-Yarn/NPM 7+ ורוצים למנוע התנגשויות
/yarn.lock         # קבצי נעילה של Yarn - אפשר להוסיף אם משתמשים ב-NPM/Yarn 2+ ורוצים למנוע התנגשויות
/pnpm-lock.yaml    # קבצי נעילה של PNPM
/out/
/dist/
/build/

# Expo
.expo/
web-build/
expo-env.d.ts
/app-example/ # אם זה תיקיית דוגמה שאינה נחוצה ב-Repo

# Native (Android/iOS) specific files to ignore
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.keystore

# Metro
.metro-health-check*

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# macOS
.DS_Store
.AppleDouble
.LSOverride
*.pem

# Local Environment Files
.env*.local
.env*.development.local
.env*.test.local
.env*.production.local

# Typescript
*.tsbuildinfo

# IDE/Editor specific files (e.g., VS Code)
.vscode/
.idea/